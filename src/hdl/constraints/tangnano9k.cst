// tangnano9k.cst — Tang Nano 9K (Gowin GW1NR-9C / GW1NR-LV9QN88PC6/I5) ピン制約
//
// "..." 内の名前は rtl/blink.sv のトップモジュールのポート名と一致させること。
// apicula(Gowin)形式。

// 27 MHz オンボードクロック
IO_LOC  "clk" 52;
IO_PORT "clk" PULL_MODE=UP;

// リセットボタン S1(押すと L レベル)
IO_LOC  "rst_n" 4;
IO_PORT "rst_n" PULL_MODE=UP;

// オンボードLED 0..5(アクティブLow: 0 で点灯)
IO_LOC  "led[0]" 10;
IO_LOC  "led[1]" 11;
IO_LOC  "led[2]" 13;
IO_LOC  "led[3]" 14;
IO_LOC  "led[4]" 15;
IO_LOC  "led[5]" 16;
IO_PORT "led[0]" PULL_MODE=NONE DRIVE=8;
IO_PORT "led[1]" PULL_MODE=NONE DRIVE=8;
IO_PORT "led[2]" PULL_MODE=NONE DRIVE=8;
IO_PORT "led[3]" PULL_MODE=NONE DRIVE=8;
IO_PORT "led[4]" PULL_MODE=NONE DRIVE=8;
IO_PORT "led[5]" PULL_MODE=NONE DRIVE=8;
